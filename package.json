{
  "name": "margin-docs",
  "version": "1.0.0",
  "description": "Margin is a local-first writing app for Windows.",
  "author": "Margin",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "electron .",
    "desktop": "pnpm build && electron .",
    "package:win": "pnpm build && electron-builder --win nsis portable --x64",
    "test": "pnpm build && node --test tests/desktop.test.mjs"
  },
  "dependencies": {
    "@tiptap/core": "^3.11.0",
    "@tiptap/extension-highlight": "^3.11.0",
    "@tiptap/extension-image": "^3.11.0",
    "@tiptap/extension-table": "^3.11.0",
    "@tiptap/extension-task-item": "^3.11.0",
    "@tiptap/extension-task-list": "^3.11.0",
    "@tiptap/extension-text-align": "^3.11.0",
    "@tiptap/extension-text-style": "^3.11.0",
    "@tiptap/pm": "^3.11.0",
    "@tiptap/starter-kit": "^3.11.0",
    "docx": "^9.5.0",
    "dompurify": "^3.3.0",
    "fflate": "^0.8.2",
    "lucide": "npm:lucide-static@^0.577.0",
    "mammoth": "^1.11.0",
    "marked": "^17.0.0",
    "pdfjs-dist": "^5.4.0",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "vite": "^7.2.0"
  },
  "build": {
    "appId": "com.margin.docs",
    "productName": "Margin",
    "npmRebuild": false,
    "directories": { "output": "release" },
    "files": ["dist/**", "desktop/**", "build/icon.png", "package.json", "!node_modules/**"],
    "asar": true,
    "win": { "icon": "build/icon.ico", "signAndEditExecutable": true, "signExecutable": false },
    "nsis": { "artifactName": "Margin-Setup.${ext}", "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true },
    "portable": { "artifactName": "Margin-Portable.${ext}" },
    "fileAssociations": [{ "ext": "margin", "name": "Margin Document", "role": "Editor" }]
  }
}
